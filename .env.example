# Junk It Out environment configuration template
# Copy to .env.local for local development. Replace placeholders locally; never
# commit populated secrets. Requiredness refers to the feature being used.

# REQUIRED — PostgreSQL application connection used at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# REQUIRED for Prisma CLI/schema workflows — direct PostgreSQL connection to
# the same database. Use a direct, non-pooler endpoint for migration commands.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?schema=public"

# REQUIRED — set the same dedicated value in the main app and admin app for
# signing/verifying JWTs. Both apps reject values shorter than 32 bytes. Do not
# reuse a payment credential or commit the generated value.
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-bytes"

# CONDITIONALLY REQUIRED — needed when sending login OTPs through Fast2SMS.
FAST2SMS_API_KEY=""
FAST2SMS_OTP_ID=""

# CONDITIONALLY REQUIRED — needed for assigned-agent SMS alerts.
# Configure a Fast2SMS DLT-approved template whose variables_values value
# matches the application message format, and use its message/template ID.
FAST2SMS_AGENT_SMS_MESSAGE_ID=""
FAST2SMS_AGENT_SMS_SENDER_ID=""
FAST2SMS_AGENT_SMS_ROUTE="dlt"

# OPTIONAL — local-only OTP shortcut for one designated phone number.
# Supported only when NODE_ENV=development and OTP_TEST_MODE=true.
# OTP_TEST_PHONE is required only when OTP_TEST_MODE is enabled.
OTP_TEST_MODE="false"
OTP_TEST_PHONE=""

# CONDITIONALLY REQUIRED — needed to create/verify Razorpay payments.
# Supported credential pairs (keep the ID and secret from the same account):
#   RAZORPAY_KEY_ID + RAZORPAY_KEY_SECRET (recommended)
#   RAZORPAY_KEY_ID + RAZORPAY_SECRET
#   PAYMENT_KEY_ID + PAYMENT_KEY_SECRET
# NEXT_PUBLIC_RAZORPAY_KEY_ID is also accepted as the key ID with any of the
# supported secret names above. A NEXT_PUBLIC key ID is not a secret.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Backward-compatible secret name accepted with RAZORPAY_KEY_ID.
RAZORPAY_SECRET=""
# Backward-compatible pair accepted by the server.
PAYMENT_KEY_ID=""
PAYMENT_KEY_SECRET=""

# CONDITIONALLY REQUIRED — when processing Razorpay webhooks.
RAZORPAY_WEBHOOK_SECRET=""

# CONDITIONALLY REQUIRED — in production when uploading photos to Vercel Blob.
BLOB_READ_WRITE_TOKEN=""

# CONDITIONALLY REQUIRED — when sending Fast2SMS WhatsApp dispatch updates.
# FAST2SMS_WHATSAPP_API_KEY falls back to FAST2SMS_API_KEY when empty.
# Message ID and phone number ID have application defaults and can be omitted.
FAST2SMS_WHATSAPP_API_KEY=""
FAST2SMS_WHATSAPP_MESSAGE_ID=""
FAST2SMS_WHATSAPP_PHONE_NUMBER_ID=""

# OPTIONAL but strongly recommended — when configured, Fast2SMS WhatsApp
# webhooks must include a matching secret header. If unset, the route skips
# secret-header verification.
FAST2SMS_WHATSAPP_WEBHOOK_SECRET=""

# OPTIONAL - application URLs. Configure NEXT_PUBLIC_API_BASE_URL explicitly.
# Server-side admin requests have no URL fallback; NEXT_PUBLIC_APP_URL is used for generated links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE_URL=""
NEXT_PUBLIC_CUSTOMER_SITE_URL=""

# OPTIONAL — runtime settings. Hosting platforms may supply NODE_ENV themselves.
NODE_ENV="development"
PORT="3000"
