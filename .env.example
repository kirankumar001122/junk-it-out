# Junk It Out — Environment Configuration Template

# Database Configuration (SQLite for dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://postgres:password@localhost:5432/junkitout?schema=public"

# Node Environment
NODE_ENV="development"
PORT=3000

# Authentication & JWT Secrets
JWT_SECRET="generate-a-long-random-secret-before-running"
JWT_EXPIRES_IN="7d"

# Fast2SMS Smart OTP (server-side only; never expose either value to the browser)
FAST2SMS_API_KEY=""
FAST2SMS_OTP_ID=""

# Payment Gateway Configuration (Razorpay TEST mode)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxx"
RAZORPAY_SECRET="your_test_secret"
RAZORPAY_WEBHOOK_SECRET="your_test_webhook_secret"

# External Services (Google Maps API)
GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Application Host URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Vercel Blob Storage Token (Required for production photo uploads)
BLOB_READ_WRITE_TOKEN=""
